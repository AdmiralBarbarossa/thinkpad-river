timeout 60  'brightnessctl -s set 2' resume 'brightnessctl -r'
timeout 120 'pidof waylock || waylock -fork-on-lock -init-color 0x000000 -input-color 0x333333 -fail-color 0xb9162a'
timeout 180 'wlopm --off eDP-1' resume 'wlopm --on eDP-1'
timeout 600 'systemctl suspend'
before-sleep 'pidof waylock || waylock -fork-on-lock -init-color 0x000000 -input-color 0x333333 -fail-color 0xb9162a'
